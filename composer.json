{
    "name": "alleyinteractive/create-mantle-package",
    "description": "Generic Mantle Package",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "authors": [],
    "require": {
        "php": "^8.3",
        "mantle-framework/support": "^1.22"
    },
    "require-dev": {
        "alleyinteractive/alley-coding-standards": "^2.6",
        "mantle-framework/testkit": "^1.22",
        "mantle-framework/types": "^1.22",
        "rector/rector": "^2.0",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Create_Mantle_Package\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Create_Mantle_Package\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "mantle": {
            "aliases": [],
            "providers": [
                "Create_Mantle_Package\\Example_Service_Provider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "lint": [
            "@phpcs",
            "@phpstan",
            "@rector"
        ],
        "lint:fix": [
            "@rector:fix",
            "@phpcbf"
        ],
        "phpcbf": "phpcbf .",
        "phpcs": "phpcs .",
        "phpstan": "phpstan --memory-limit=512M",
        "phpunit": "phpunit",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process",
        "test": [
            "@lint",
            "@phpunit"
        ]
    }
}
